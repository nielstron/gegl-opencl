<?xml version='1.0' encoding='UTF-8'?>
<gegl>
  <!-- outside the input extent the result depends on how the output
       is split into chunks, also on the CPU, so compare inside only -->
  <node operation='gegl:crop'>
    <params>
      <param name='width'>512</param>
      <param name='height'>384</param>
    </params>
  </node>
  <node operation='gegl:motion-blur-circular'>
    <params>
      <param name='angle'>30</param>
      <param name='center-x'>0.3</param>
      <param name='center-y'>0.6</param>
    </params>
  </node>
  <node operation='gegl:load'>
    <params>
      <param name='path'>../compositions/data/car-stack.png</param>
    </params>
  </node>
</gegl>
